# Hosts
WP_HOST=example.com
LICENSE_HOST=license.example.com

# Database (WordPress)
WORDPRESS_DB=wordpress
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=change_me

# MariaDB root password
MYSQL_ROOT_PASSWORD=change_me_root

# Postgres (license-server)
POSTGRES_DB=gdwb_app
POSTGRES_USER=gdwb_user
POSTGRES_PASSWORD=change_me

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# Other
LICENSE_PRIVATE_KEY_PATH=/run/secrets/license_private.pem
# .env.example for gd-workflow-bridge-pro
# Copy this file to .env and fill real secrets. Do NOT commit .env

# PostgreSQL
POSTGRES_USER=gdwb_user
POSTGRES_PASSWORD=CHANGEME_REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=gdwb_app

# JWT / Auth
AUTH_JWT_SECRET=CHANGEME_REPLACE_WITH_AUTH_SECRET

# Billing
BILLING_ADMIN_TOKEN=CHANGEME_REPLACE_WITH_BILLING_ADMIN_TOKEN
BILLING_CURRENCY=USD

# Redis / Pushgateway
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379
PUSHGATEWAY_URL=http://pushgateway:9091
PUSHGATEWAY_ENABLED=true
GATEWAY_AUTH_CACHE_TTL=10
GATEWAY_SUPERVISOR_RESTART_DELAY=3
GATEWAY_SUPERVISOR_CHECK_INTERVAL=5
GATEWAY_HEALTH_TOKEN=CHANGEME_REPLACE_WITH_RANDOM_TOKEN

# Misc / DB
PGHOST=postgres
PGPORT=5432

# Optional service ports
LICENSE_SERVER_PORT=8001
GATEWAY_PORT=8000
GATEWAY_CORS_ORIGIN=*
# Environment Configuration Template
# Copy this file to .env and fill in your values

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# === Database ===
DATABASE_URL=postgresql://user:password@postgres:5432/gdwb_app
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_NAME=gdwb_app

# === Redis ===
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# === License Server ===
LICENSE_SERVER_ENV=dev
LICENSE_PRIVATE_KEY_PATH=/app/license-server/keys/private.pem
LICENSE_ADMIN_TOKEN=your_admin_token_here
LICENSE_PLANS_FILE=/app/license-server/data/plans.json

# === AWS ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=gdwb-assets-dev
AWS_ACCOUNT_ID=123456789012

# === Payment Gateways ===
# Stripe (Global)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack (Africa: Nigeria, Ghana, South Africa, Kenya, Uganda)
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# Razorpay (India & South Asia)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# PayPal (Global Fallback)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox  # or 'live'

# === Auth0 ===
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_CALLBACK_URL=http://localhost/auth/callback

# === Cloudflare ===
CLOUDFLARE_API_KEY=your_api_key
CLOUDFLARE_ACCOUNT_EMAIL=your_email@example.com
CLOUDFLARE_ZONE_ID=your_zone_id

# === GoDaddy (Domain Registration) ===
GODADDY_API_KEY=your_api_key
GODADDY_API_SECRET=your_api_secret

# === SendGrid ===
SENDGRID_API_KEY=SG.your_key_here
SENDGRID_FROM_EMAIL=noreply@example.com

# === Datadog ===
DATADOG_API_KEY=your_api_key
DATADOG_APP_KEY=your_app_key
DATADOG_SITE=datadoghq.com

# === Logging ===
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_PATH=/var/log/app

# === Security ===
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
SESSION_SECRET=your_session_secret

# === Email ===
MAIL_DRIVER=sendgrid
MAIL_FROM_NAME="GDWB Platform"

# === Payment Processing ===
PAYMENT_GATEWAY=stripe
CURRENCY=usd
TAX_ENABLED=true

# === Feature Flags ===
FEATURE_MARKETPLACE=true
FEATURE_DOMAINS=true
FEATURE_CMS=true
FEATURE_CUSTOM_BRANDING=false

# === Rate Limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# myApp-backend configuration removed; backend not started by compose by default
