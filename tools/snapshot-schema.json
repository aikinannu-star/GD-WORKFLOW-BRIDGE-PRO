{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marketplace Snapshot",
  "type": "object",
  "required": ["id","created_at","files"],
  "properties": {
    "id": {"type":"string"},
    "created_at": {"type":"string","format":"date-time"},
    "files": {
      "type": "object",
      "properties": {
        "plugins.json": {"type":"array"},
        "plugins_versions.json": {"type":"array"},
        "plugin_installs.json": {"type":"array"},
        "plugin_keys.json": {"type":"array"},
        "plugin_ratings.json": {"type":"array"}
      }
    }
  }
}
