{
  "name": "GDWB Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:0-bullseye",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "gateway-service",
  "workspaceFolder": "/workspaces/gd-workflow-bridge-pro",
  "runServices": [
    "postgres",
    "redis",
    "license-server",
    "gateway-service",
    "auth-service",
    "billing-service",
    "usage-service"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000, 8001, 8010, 5432, 6379, 9090, 9091],
  "postCreateCommand": "cp .env.example .env || true && echo 'Please edit .env (set secrets) and update MYAPP_BACKEND_PATH if you want the Node backend included.'",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "mhutchie.git-graph"
      ]
    }
  }
}
