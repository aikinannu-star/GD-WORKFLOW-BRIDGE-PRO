<?xml version="1.0"?>
<ruleset name="GD Workflow Bridge Pro">
    <description>WordPress coding standards for GD Workflow Bridge Pro</description>

    <!-- WordPress standards -->
    <rule ref="WordPress">
        <exclude name="WordPress.VIP.SuperGlobalInputUse.AccessDetected" />
        <exclude name="WordPress.VIP.RestrictedVariables.user_meta__wpdb__usermeta" />
    </rule>

    <rule ref="WordPress-Core" />
    <rule ref="WordPress-Docs" />
    <rule ref="WordPress-Extra" />

    <!-- Check for PHP compatibility with 8.0+ -->
    <config name="minimum_supported_wp_version" value="6.0" />
    <config name="testVersion" value="8.0-" />
    <rule ref="PHPCompatibilityWP" />

    <!-- Folders and files to scan -->
    <file>.</file>

    <!-- Exclude vendor and other non-essential directories -->
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>
    <exclude-pattern>/.git/</exclude-pattern>
    <exclude-pattern>/languages/</exclude-pattern>

    <!-- Check these file types -->
    <arg name="extensions" value="php" />
</ruleset>
